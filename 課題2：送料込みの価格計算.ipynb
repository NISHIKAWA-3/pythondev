   "source": [
    "price = int(input(\"税抜き価格を入力してください: \"))\n",
    "print(f\"税抜き価格を入力してください:{price} \")\n",
    "including_tax = round(price * 1.1)\n",
    "\n",
    "if including_tax >= 2000:\n",
    "    print(\"送料は無料です\")\n",
    "    print(\"送料込みの価格は\", including_tax, \"円です。\")\n",
    "else:\n",
    "    print(\"送料として350円かかります\")\n",
    "    print(\"送料込みの価格は\",including_tax + 350, \"円です。\")"
   ]
  }
